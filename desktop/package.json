{
  "name": "hfm-korea-hts-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "HFM KOREA native multi-pane Windows HTS sharing the existing authenticated trading backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "kr.co.hfmkorea.hts",
    "productName": "HFM KOREA HTS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.cjs",
      "layout.cjs",
      "preload.js",
      "workspace.html",
      "workspace.js",
      "offline.html",
      "package.json",
      "updater.cjs"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "HFM-KOREA-HTS-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "HFM-KOREA-HTS-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BITMATE-del",
        "repo": "HFM-KOREA",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
